# Скопируйте файл в data/run/safe-runtime.env, проверьте абсолютные пути,
# затем подключите его командой: source data/run/safe-runtime.env

export ARENA_LMSTUDIO_HOME=/home/seraf/.lmstudio
export ARENA_LM_MODEL_DIR=/home/seraf/.lmstudio/models/lmstudio-community/Qwen3.5-0.8B-GGUF
export ARENA_RUNTIME_CONFIG_CONTAINER=/app/configs/runtime.example.json

# Геометрию задавайте только после измерения client area и только всей тройкой.
